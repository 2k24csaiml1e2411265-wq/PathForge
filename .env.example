# Copy this file to ".env" and fill in your own values.
# PathForge runs perfectly fine WITHOUT a Gemini key — it just falls back
# to the built-in template-based recommendation/roadmap generator instead
# of LLM-generated explanations.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — which Gemini model to call (default used if left blank)
GEMINI_MODEL=gemini-2.0-flash
